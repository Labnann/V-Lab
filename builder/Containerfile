FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y \
        debootstrap \
        parted \
        util-linux \
        e2fsprogs \
        dosfstools \
        mount \
        rsync \
        grub-efi-amd64 \
        grub-pc-bin \
        grub2-common \
        zstd \
        ca-certificates \
        udev \
        systemd-container \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY build-image.sh /usr/local/bin/build-image.sh
COPY hooks/ /usr/local/lib/vlab/hooks
COPY assets/vlab_logos/ /usr/local/share/vlab/assets/vlab_logos

RUN chmod +x /usr/local/lib/vlab/hooks/*.sh
RUN chmod +x /usr/local/bin/build-image.sh

ENTRYPOINT ["/usr/local/bin/build-image.sh"]
